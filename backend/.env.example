# Server Port (Render sets this automatically)
PORT=5000

# Secret key used for signing JWT tokens
JWT_SECRET=careerpilot_super_secret_jwt_key_2026_dev

# MongoDB Atlas Connection URI (Get this free from https://cloud.mongodb.com)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/careerpilot?retryWrites=true&w=majority
# If omitted or left empty, CareerPilot AI will automatically run in fast local in-memory store mode.
MONGODB_URI=
